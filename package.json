{
  "name": "outbox-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "worker": "tsx server/worker.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@elastic/elasticsearch": "^8.17.0",
    "@fontsource/dm-sans": "^5.3.0",
    "bullmq": "^5.58.0",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
